{
    "name": "nemo64/dbal-rds-data",
    "description": "rds-data driver for doctrine dbal",
    "keywords": [
        "doctrine",
        "dbal",
        "orm",
        "driver",
        "rds",
        "aurora",
        "serverless",
        "aws",
        "sdk",
        "data",
        "data-api",
        "symfony"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Marco Pfeiffer",
            "email": "git@marco.zone"
        },
        {
            "name": "Woody Gilk",
            "email": "woody.gilk@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "aws/aws-sdk-php": "^3.98",
        "doctrine/dbal": "^4.0"
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Nemo64\\DbalRdsData\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nemo64\\DbalRdsData\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
